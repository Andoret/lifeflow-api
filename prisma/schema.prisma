// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL_POOLING")
  directUrl = env("DIRECT_URL")
}


model Roles{
  roleId Int @id @default(autoincrement())  
  description String

  users       Users[]
}

model Users{
  userId Int @id @default(autoincrement())
  email String @unique
  name String
  roleId Int 
  password String
  lastLogin DateTime?
  active Boolean @default(true)
  deletedBy Int?
  updatedBy Int?

  role      Roles    @relation(fields: [roleId], references: [roleId])
  expenses  Expenses[]
  categories Categories[]
  speeches   ExpensesToSpeech[]
  exCatUser exCatUser[]
}

model Categories {
  categoryId Int    @id @default(autoincrement())
  userId     Int
  name       String

  user     Users     @relation(fields: [userId], references: [userId])
  expenses Expenses[]
  @@unique([userId, name])
}

model Expenses{
  expenseId Int @id @default(autoincrement())
  userId Int 
  categoryId  Int
  description String
  price Float
  date DateTime @default(now())

  user      Users    @relation(fields: [userId], references: [userId])
  category  Categories @relation(fields: [categoryId], references: [categoryId])

}

model ExpensesToSpeech{
  expenseTsId Int @id @default(autoincrement())
  userId Int
  requestId String
  date DateTime @default(now())

  user        Users    @relation(fields: [userId], references: [userId])
}


model ExcerciseCategories{
  exCatId Int @id @default(autoincrement())
  catname String

  exCatUsers exCatUser[]
}


model exCatUser{
  exCatUId Int @id @default(autoincrement())
  exCatId  Int
  userId Int
  reqResponse String
  dateUsing DateTime @default(now()) 
  exCat       ExcerciseCategories    @relation(fields: [exCatId], references: [exCatId])
  user        Users    @relation(fields: [userId], references: [userId])
}